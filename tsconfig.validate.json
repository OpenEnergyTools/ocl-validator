{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020", "DOM"],
        "declaration": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declarationMap": true
    },
    "include": [
        "src/validate.ts",
        "src/ValidationIssue.ts",
        "src/index.ts",
        "src/RequiredElements/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test",
        "**/*.test.ts",
        "src/RequiredAttributes/**/*",
        "src/SemanticConstraints/**/*",
        "src/FileSpecifics/**/*",
        "src/Helpers/**/*"
    ]
}